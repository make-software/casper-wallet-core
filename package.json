{
  "name": "CasperWalletCore",
  "version": "1.4.0",
  "description": "Core business logic and data layer for the Casper Wallet browser extension and mobile app.",
  "license": "Apache-2.0",
  "author": "MAKE Software",
  "homepage": "https://github.com/make-software/casper-wallet-core#readme",
  "bugs": {
    "url": "https://github.com/make-software/casper-wallet-core/issues"
  },
  "keywords": [
    "casper",
    "casper-network",
    "wallet",
    "blockchain",
    "typescript",
    "cspr"
  ],
  "main": "index.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/make-software/casper-wallet-core"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code:check": "tsc --skipLibCheck --noEmit && yarn lint && yarn format:check",
    "prepare": "husky",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchman=false",
    "test:integration": "jest --testPathPattern=integration.test --watchman=false",
    "fixtures:generate": "node scripts/generate-tx-fixtures.cjs"
  },
  "dependencies": {
    "@casper-ecosystem/casper-eip-712": "1.2.1",
    "@noble/hashes": "^1.8.0",
    "apisauce": "^3.2.2",
    "casper-js-sdk": "5.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "deepmerge": "^4.3.1",
    "lru-cache": "11.5.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "^0.87.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "axios": "^1.19.0",
    "form-data": "^4.0.6",
    "bn.js": "^5.2.5",
    "brace-expansion@^1.1.7": "^1.1.18",
    "brace-expansion@^5.0.5": "^5.0.9",
    "js-yaml@^3.13.1": "^3.15.1",
    "js-yaml@^4.3.0": "^4.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "packageManager": "yarn@4.2.2"
}
